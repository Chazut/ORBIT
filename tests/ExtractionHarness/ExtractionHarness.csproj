<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);EXTRACTION_HARNESS</DefineConstants>
    <RecoverySlice>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/Recovery.Generated.cs</RecoverySlice>
    <GotoSource Condition="'$(GotoSource)' == ''">../../Orbit/Tasks/Actions/GotoObjectiveAction.cs</GotoSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Shared/ZoneScope.cs;../../Shared/CustomsBackport.cs;../../Shared/FloorCatalog.cs;../../Shared/NativeFloorResolver.cs" />
    <Compile Include="../../Orbit/Navigation/LootVisibility.cs" />
    <Compile Remove="Recovery.Generated.cs" />
    <Compile Include="$(RecoverySlice)" />
    <Compile Include="../NavigationHarness/ArrivalPorts.cs" Link="ArrivalPorts.cs" />
    <Compile Include="../../Orbit/Api/OrbitExtractionEvents.cs" />
    <Compile Include="../../Orbit/Api/OrbitDoorEvents.cs" />
    <Compile Include="../../Orbit/Navigation/WoodsBunkerAccess.cs" />
    <Compile Include="../../Orbit/Navigation/OperationProgress.cs" />
    <Compile Include="../../Orbit/Navigation/OperationRoutePolicy.cs" />
    <Compile Include="../../Orbit/Navigation/OperationRouteSearch.cs" />
    <Compile Include="../../Orbit/Systems/ExfilApproach.cs" />
    <Compile Include="../../Orbit/Systems/MovementSystem.BunkerGate.cs" />
    <Compile Include="../../Orbit/Systems/MovementFailureHistory.cs" />
    <Compile Include="../../Orbit/Navigation/AirdropVisibility.cs" Link="AirdropVisibility.cs" />
    <Compile Include="../../Orbit/Systems/RescueProgress.cs" Link="RescueProgress.cs" />
    <Compile Include="../../Orbit/Systems/MovementSystem.LocalEscape.cs" Link="MovementSystem.LocalEscape.cs" />
    <Compile Include="../../Orbit/Systems/QuestArrival.cs" Link="QuestArrival.cs" />
    <Compile Include="../../Orbit/Tasks/QuestObjectiveRecovery.cs" Link="QuestObjectiveRecovery.cs" />
    <Compile Include="../../Orbit/Entities/MainObjective.cs" Link="MainObjective.cs" />
    <Compile Include="../../Orbit/Navigation/ArrivalFailureHistory.cs" Link="ArrivalFailureHistory.cs" />
    <Compile Include="../../Orbit/Systems/OrbitMovementRecovery.cs" Link="OrbitMovementRecovery.cs" />
    <Compile Include="../NavigationHarness/Doubles.cs" Link="Doubles.cs" />
    <Compile Include="../../Orbit/Tasks/Actions/ExtractAction.cs" Link="ExtractAction.cs" />
    <Compile Include="$(GotoSource)" Link="GotoObjectiveAction.cs" />
    <Compile Include="../../Orbit/Tasks/Task.cs" Link="Task.cs" />
    <Compile Include="../../Orbit/Core/TaskInfrastructure.cs" Link="TaskInfrastructure.cs" />
    <Compile Include="../../Orbit/Entities/ObjectiveComponents.cs" Link="ObjectiveComponents.cs" />
    <Compile Include="../../Orbit/Navigation/ExfilArrival.cs" Link="ExfilArrival.cs" />
    <Compile Include="../../Orbit/Navigation/ExfilNavigation.cs" Link="ExfilNavigation.cs" />
    <Compile Include="../../Orbit/Navigation/Waypoint.cs" Link="Waypoint.cs" />
    <Compile Include="../../Orbit/Navigation/CoverPoint.cs" Link="CoverPoint.cs" />
  </ItemGroup>
  <Target Name="PrepareRecoverySlice" BeforeTargets="CoreCompile"
          Inputs="$(MSBuildProjectDirectory)/../../Orbit/Systems/MovementSystem.cs;$(MSBuildProjectDirectory)/prepare_recovery.py"
          Outputs="$(RecoverySlice)">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="python &quot;prepare_recovery.py&quot; &quot;$(RecoverySlice)&quot;" />
  </Target>
</Project>
