    <BepCore>$(SptRoot)/BepInEx/core</BepCore>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepCore)/BepInEx.dll" />
    <Reference Include="0Harmony" HintPath="$(BepCore)/0Harmony.dll" />
