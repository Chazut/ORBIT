<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
        <TargetFramework>netstandard2.1</TargetFramework>
        <Nullable>disable</Nullable>
        <LangVersion>default</LangVersion>
        <Deterministic>false</Deterministic>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Compile references: frozen copy of the SPT 4.1 client DLLs (refs/4.1, gitignored) -->
        <SptRoot Condition=" '$(SptRoot)' == '' ">$(MSBuildProjectDirectory)\..\refs\4.1</SptRoot>
        <!-- Deployment target: the live SPT 4.1 install -->
        <DeployRoot Condition=" '$(DeployRoot)' == '' ">C:\Games\SPT-4.1</DeployRoot>
        <AssemblyName>ORBIT</AssemblyName>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <DebugType>full</DebugType>
    </PropertyGroup>

    <ItemGroup>
      <Reference Include="0Harmony">
        <HintPath>$(SptRoot)\BepInEx\core\0Harmony.dll</HintPath>
      </Reference>
      <Reference Include="Assembly-CSharp">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
      </Reference>
      <Reference Include="BepInEx">
        <HintPath>$(SptRoot)\BepInEx\core\BepInEx.dll</HintPath>
      </Reference>
      <Reference Include="Comfort">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Comfort.dll</HintPath>
      </Reference>
      <Reference Include="ItemComponent.Types">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\ItemComponent.Types.dll</HintPath>
      </Reference>
      <Reference Include="DrakiaXYZ-BigBrain">
        <HintPath>$(SptRoot)\BepInEx\plugins\DrakiaXYZ-BigBrain.dll</HintPath>
      </Reference>
      <Reference Include="Newtonsoft.Json">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Newtonsoft.Json.dll</HintPath>
      </Reference>
      <Reference Include="websocket-sharp">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\websocket-sharp.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Sirenix.Serialization">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Sirenix.Serialization.dll</HintPath>
      </Reference>
      <Reference Include="spt-common">
        <HintPath>$(SptRoot)\BepInEx\plugins\spt\spt-common.dll</HintPath>
      </Reference>
      <Reference Include="spt-core">
        <HintPath>$(SptRoot)\BepInEx\plugins\spt\spt-core.dll</HintPath>
      </Reference>
      <Reference Include="spt-reflection">
        <HintPath>$(SptRoot)\BepInEx\plugins\spt\spt-reflection.dll</HintPath>
      </Reference>
      <Reference Include="Unity.Postprocessing.Runtime">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Unity.Postprocessing.Runtime.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine.AIModule">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.AIModule.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine.AssetBundleModule">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.AssetBundleModule.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine.CoreModule">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine.AudioModule">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.AudioModule.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="UnityEngine.ImageConversionModule">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine.IMGUIModule">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine.ParticleSystemModule">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.ParticleSystemModule.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine.PhysicsModule">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine.TerrainPhysicsModule">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.TerrainPhysicsModule.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine.TerrainModule">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.TerrainModule.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine.TextRenderingModule">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      </Reference>
    </ItemGroup>

    <ItemGroup>
      <Compile Include="..\Shared\*.cs" Link="Zones\%(Filename)%(Extension)" />
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(DeployOnBuild)' != 'false' and '$(BuildingFikaReference)' != 'true'">
      <MakeDir Directories="$(DeployRoot)\BepInEx\plugins\$(TargetName)" />
      <Exec Command="copy /Y &quot;$(TargetPath)&quot; &quot;$(DeployRoot)\BepInEx\plugins\$(TargetName)\$(TargetFileName)&quot;&#xA;copy /Y &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;$(DeployRoot)\BepInEx\plugins\$(TargetName)\$(TargetName).pdb&quot;" />
    </Target>


  <!-- Build a private transport against a reference pass of this plugin. The main
       assembly has no Fika type references; only these bytes ship inside it. -->
  <PropertyGroup>
    <FikaBridgeOutput>$(MSBuildProjectDirectory)/../Orbit.Fika/bin/$(Configuration)/netstandard2.1/ORBIT.Fika.Integration.dll</FikaBridgeOutput>
    <FikaReferenceOutput>$(MSBuildProjectDirectory)/obj/fika-reference-bin/$(Configuration)/ORBIT.dll</FikaReferenceOutput>
  </PropertyGroup>
  <Target Name="BuildEmbeddedFika" BeforeTargets="PrepareForBuild" Condition="'$(BuildingFikaReference)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build"
      Properties="BuildingFikaReference=true;DeployOnBuild=false;OutputPath=$(MSBuildProjectDirectory)/obj/fika-reference-bin/$(Configuration)/;IntermediateOutputPath=obj/fika-reference/$(Configuration)/" />
    <MSBuild Projects="$(MSBuildProjectDirectory)/../Orbit.Fika/Orbit.Fika.csproj" Targets="Restore;Build"
      Properties="MainAssemblyPath=$(FikaReferenceOutput);Configuration=$(Configuration)"
      RemoveProperties="BuildingFikaReference;OutputPath;IntermediateOutputPath" />
  </Target>
  <ItemGroup Condition="'$(BuildingFikaReference)' != 'true'">
    <EmbeddedResource Include="$(FikaBridgeOutput)" LogicalName="ORBIT.Fika.Integration.dll" />
  </ItemGroup>
</Project>
