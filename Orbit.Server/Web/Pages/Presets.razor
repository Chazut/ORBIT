@page "/orbit/presets"
@layout Orbit.Server.Web.Shared.MainLayout
@implements IDisposable
@using Orbit.Server.Presets
@inject Orbit.Server.Presets.PresetService Store
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Presets - ORBIT</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    <MudText Typo="Typo.h5" Class="mb-2">Presets</MudText>
    <MudText Typo="Typo.body2" Class="mb-5" Style="opacity:.7">
        Choose config, zones or both when selecting a preset at the top of any page.
        Selecting just one part creates a personal Custom copy and keeps the other part of your current setup.
        Switching saves your current edits. Save applies the selected preset from the next raid;
        faction takeover and personality brain lists need a game restart.
    </MudText>

    <SettingsCard Title="@($"Editing: {Store.ActiveName}")"
                  Subtitle="Default and addon sources are protected. Changing any setting or zone creates a personal Custom copy automatically.">
        <div class="d-flex flex-wrap align-center" style="gap:12px">
            <MudTextField T="string" @bind-Value="PresetName" Label="Preset name" Variant="Variant.Outlined" Margin="Margin.Dense"
                          MaxLength="60" Immediate="true"
                          Style="min-width:220px; flex:1" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Duplicate" Disabled="@(Store.Error != null || string.IsNullOrWhiteSpace(_name))"
                       StartIcon="@Icons.Material.Filled.ContentCopy">Save as new preset</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="Rename" Disabled="@(Store.ReadOnly || Store.Error != null || string.IsNullOrWhiteSpace(_name))">Rename current</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="Export" Disabled="@(Store.Error != null || _choosing)"
                       StartIcon="@Icons.Material.Filled.IosShare">Export preset ZIP</MudButton>
        </div>
        @if (_exportHref != null)
        {
            <MudButton Class="mt-3" Href="@_exportHref" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                       UserAttributes="@(new Dictionary<string, object?> { ["download"] = _exportFileName })">Download ZIP</MudButton>
        }
    </SettingsCard>

    <SettingsCard Title="Your presets" Subtitle="Each personal preset keeps its own settings and zones. A preset must be inactive before you can delete it.">
        @foreach (var preset in Store.Choices)
        {
            <div class="d-flex flex-wrap align-center py-3" style="gap:12px; border-bottom:1px solid #222B3E">
                <MudIcon Icon="@(preset.ReadOnly ? Icons.Material.Filled.Lock : Icons.Material.Filled.Tune)" Color="@(preset.Id == Store.ActiveId ? Color.Primary : Color.Default)" />
                <div style="flex:1; min-width:180px">
                    <MudText Typo="Typo.subtitle2">@preset.Name</MudText>
                    <MudText Typo="Typo.caption" Style="opacity:.65">@preset.Contents@(preset.Source != null ? $" | addon/{preset.Source}" : "")</MudText>
                </div>
                @if (preset.Id == Store.ActiveId)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">Selected</MudChip>
                }
                else
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => Select(preset.Id))" Disabled="@(Store.Error != null || _choosing)">Use preset</MudButton>
                }
                @if (!preset.ReadOnly)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Color="Color.Error"
                                   title="Delete preset" Disabled="@(preset.Id == Store.ActiveId || Store.Error != null)"
                                   OnClick="@(() => Delete(preset.Id, preset.Name))" />
                }
            </div>
        }
    </SettingsCard>

    <SettingsCard Title="Addons" Subtitle="Extract preset ZIPs into your game folder. Each folder in SPT_Runtime/user/mods/ORBIT/addon becomes one preset.">
        <MudText Typo="Typo.body2" Class="mb-3" Style="opacity:.75">
            Export config.json, zones.json or both in one ZIP. Existing JSON exports are still supported.
            Accepts global settings, zone packs and complete presets. A partial addon replaces only the settings
            and maps it contains, keeping everything else from the current preset. Its source file stays unchanged.
            Updates to the selected addon apply automatically, including after a server restart.
            Personal edits stay in Custom. A missing or incomplete file keeps the last valid version.
            Keep the folder name and JSON filenames unchanged when publishing updates. Put version numbers
            in the ZIP filename only, so users can extract updates into the same game folder and replace the existing files.
        </MudText>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="Refresh" StartIcon="@Icons.Material.Filled.Refresh">Refresh addons</MudButton>
        @foreach (var error in Store.AddonErrors)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@error</MudAlert>
        }
    </SettingsCard>
</MudContainer>

@code {
    private string _name = "";
    private string PresetName
    {
        get => _name;
        set { _name = value; _exportHref = null; }
    }
    private bool _choosing;
    private string? _exportHref;
    private string? _exportFileName;
    private string _exportVersion = "";
    protected override void OnInitialized() => Store.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(() => { _exportHref = null; StateHasChanged(); });
    public void Dispose() => Store.Changed -= OnChanged;
    private void Run(Action action, string message)
    {
        try
        {
            action();
            Snackbar.Add(message, Severity.Success);
            if (Store.MirrorWarning != null) Snackbar.Add(Store.MirrorWarning, Severity.Warning);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
    private void Duplicate() => Run(() => { Store.Duplicate(_name); _name = ""; }, "New preset saved and selected.");
    private void Rename() => Run(() => { Store.Rename(_name); _name = ""; }, "Preset renamed.");
    private async Task Select(string id)
    {
        if (_choosing) return;
        _choosing = true;
        try
        {
            var preset = Store.Choices.FirstOrDefault(p => p.Id == id)
                ?? throw new InvalidOperationException("This preset is no longer available.");
            var parts = await PresetScopeDialog.ChooseSelection(Dialogs, preset);
            if (parts != null) Run(() => Store.Switch(id, parts.Value), parts == PresetParts.ConfigAndZones
                ? "Preset selected. Previous edits saved. Applies next raid."
                : "Custom copy created and selected. The other part of your setup was kept. Applies next raid.");
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _choosing = false; }
    }
    private async Task Export()
    {
        if (_choosing) return;
        _choosing = true;
        try
        {
            var dialog = await Dialogs.ShowAsync<PresetScopeDialog>("Export preset", new DialogParameters
            {
                [nameof(PresetScopeDialog.Exporting)] = true,
                [nameof(PresetScopeDialog.SourceName)] = Store.ActiveName,
                [nameof(PresetScopeDialog.InitialName)] = _name,
                [nameof(PresetScopeDialog.InitialVersion)] = _exportVersion,
            }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
            if (await dialog.Result is { Canceled: false, Data: PresetScopeDialog.Choice choice })
                Run(() =>
                {
                    _exportHref = null;
                    var archive = Store.Export(choice.Name, choice.Parts, choice.Version);
                    _name = choice.Name;
                    _exportVersion = choice.Version;
                    _exportFileName = archive.FileName;
                    _exportHref = "data:application/zip;base64," + Convert.ToBase64String(archive.Bytes);
                }, "ZIP ready. Extract it into your game folder to install the addon.");
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _choosing = false; }
    }
    private void Refresh() => Run(() => Store.RefreshAddons(force: true), "Addon folder scanned.");
    private async Task Delete(string id, string name)
    {
        if (await Dialogs.ShowMessageBoxAsync("Delete preset", $"Delete '{name}'? This removes its saved settings and zones.", yesText: "Delete", cancelText: "Cancel") == true)
            Run(() => Store.Delete(id), "Preset deleted.");
    }
}
