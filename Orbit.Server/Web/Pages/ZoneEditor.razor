                {
                    <MudText Typo="Typo.body2" Class="mt-2" Style="opacity:.7">@_importSummary</MudText>
                }
            </div>
        </div>
    </SettingsCard>

</MudContainer>

@code {
    private const int CanvasW = 1160;

    private string _mapId = "bigmap";
    private MapZoneModel _zones = new();
    private MapView _view = MapViews.Views["bigmap"];
    private MapRenders.InlineRender? _inlineSvg;
    private float _minX, _maxX, _minZ, _maxZ, _spanX, _spanZ, _vh, _canvasH;
    private float _zoom = 1f, _panX, _panY;
    private int _selectedCustom = -1;
    private int _hoverCustom = -1;
    private string? _selectedBuiltin;
    private string? _hoverBuiltin;
    private bool _draggingZone, _panning;
    private bool _showField = true;
    private bool _showHeat;
    private bool _middlePan;
    private bool _builtinDragHintShown;
    private double _panStartOx, _panStartOy;
    private float _dragDx, _dragDz;
    private double _lastOx, _lastOy;

    private string CursorStyle => _draggingZone ? "grabbing" : _panning ? "move" : "crosshair";

    protected override void OnInitialized()
    {
        ZoneStore.ZonesReplaced += OnZonesReplaced;
        LoadMap(_mapId);
    }

    public void Dispose() => ZoneStore.ZonesReplaced -= OnZonesReplaced;

    private void OnZonesReplaced()
    {
        // Working copies were swapped (Discard all / Reset) — re-bind and re-render.
        InvokeAsync(() =>
        {
            _zones = ZoneStore.GetWorking(_mapId);
            // Undo / redo lands here too: keep the selection when it still exists, the card being edited
            // must not vanish under the cursor every time a slider move is undone.
            if (_selectedCustom >= _zones.CustomZones.Count) _selectedCustom = -1;
            if (_selectedBuiltin != null && !_zones.BuiltinZones.ContainsKey(_selectedBuiltin)) _selectedBuiltin = null;
            StateHasChanged();
        });
    }

    // Multi-floor tarkov.dev renders are inlined with the upper floors hidden; until the fetch lands
    // (or when it fails) the plain <image> keeps drawing the stacked file.
    private async Task LoadInlineRenderAsync(string mapId, MapView view)
    {
        var render = await MapRenders.InlineSvgAsync(mapId, view);
        if (render == null || _mapId != mapId) return;
        _inlineSvg = render;
        await InvokeAsync(StateHasChanged);
    }

    // The browser starts its autoscroll on a middle-button mousedown; only a script can cancel that one
    // button without also swallowing the left click's default (focus changes, which commit a typed value).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            await JS.InvokeVoidAsync("eval", "(function(){var el=document.getElementById('orbit-zone-pad');if(!el||el.__orbitMid)return;el.__orbitMid=true;el.addEventListener('mousedown',function(e){if(e.button===1)e.preventDefault();});})()");
        }
        catch
        {
            // Script blocked: middle-button panning still works, the browser's autoscroll icon shows up.
        }
    }

    private string CustomLabel(int index)
    {
        var zone = _zones.CustomZones[index];
        return string.IsNullOrWhiteSpace(zone.Name)
            ? $"Custom {index + 1} ({zone.Position.X:F0}, {zone.Position.Y:F0})"
            : zone.Name!;
    }

    private void CopyToSibling(string siblingId)
    {
        ZoneStore.CopyWorking(_mapId, siblingId);
        Snackbar.Add($"Zones copied to {ZoneStoreService.MapLabels[siblingId]} as unsaved changes: review them there, then Save.", Severity.Success);
    }

    /// <summary>Copy of the selected zone as a new custom zone, offset so both stay visible, and selected.</summary>
    private void DuplicateSelected()
    {
        CustomZoneModel copy;
        float x, z;
        if (_selectedCustom >= 0 && _selectedCustom < _zones.CustomZones.Count)
        {
            var source = _zones.CustomZones[_selectedCustom];
            copy = new CustomZoneModel
            {
                Name = string.IsNullOrWhiteSpace(source.Name) ? null : Truncate(source.Name + " copy"),
                Radius = new ZoneRange { Min = source.Radius.Min, Max = source.Radius.Max },
                Force = new ZoneRange { Min = source.Force.Min, Max = source.Force.Max },
                Decay = source.Decay,
                KillMains = source.KillMains,
            };
            (x, z) = (source.Position.X, source.Position.Y);
        }
        else if (_selectedBuiltin != null && _zones.BuiltinZones.TryGetValue(_selectedBuiltin, out var builtin)
                 && BuiltinZonePositions.TryGet(_mapId, _selectedBuiltin, out var pos))
        {
            copy = new CustomZoneModel
            {
                Name = Truncate(_selectedBuiltin + " copy"),
                Radius = new ZoneRange { Min = builtin.Radius.Min, Max = builtin.Radius.Max },
                Force = new ZoneRange { Min = builtin.Force.Min, Max = builtin.Force.Max },
                Decay = builtin.Decay,
                KillMains = builtin.KillMains,
            };
            (x, z) = (pos.X, pos.Z);
        }
        else
        {
            return;
        }

        // Offset by a fraction of the radius, flipped when that would leave the map.
        var offset = Math.Clamp(copy.Radius.Min * 0.35f, 15f, 80f);
        var (cx, cz) = ClampToWorld(MathF.Round(x + offset), MathF.Round(z - offset));
        if (MathF.Abs(cx - x) < 1f && MathF.Abs(cz - z) < 1f)
            (cx, cz) = ClampToWorld(MathF.Round(x - offset), MathF.Round(z + offset));
        copy.Position = new ZoneVec { X = cx, Y = cz };
        _zones.CustomZones.Add(copy);
        SelectCustom(_zones.CustomZones.Count - 1);
    }

    private static string Truncate(string name) => name.Length <= 40 ? name : name[..40];

    private void LoadMap(string mapId)
    {
        _mapId = mapId;
        _view = MapViews.Views[mapId];
        _inlineSvg = null;
        if (_view.HideLayers is { Length: > 0 }) _ = LoadInlineRenderAsync(mapId, _view);
        var (rx1, rz1) = Rot(_view.X1, _view.Z1, _view.Rot);
        var (rx2, rz2) = Rot(_view.X2, _view.Z2, _view.Rot);
        _minX = MathF.Min(rx1, rx2);
        _maxX = MathF.Max(rx1, rx2);
        _minZ = MathF.Min(rz1, rz2);
        _maxZ = MathF.Max(rz1, rz2);
        _spanX = MathF.Max(1f, _maxX - _minX);
        _spanZ = MathF.Max(1f, _maxZ - _minZ);
        _vh = 1000f * _spanZ / _spanX;
        _canvasH = CanvasW * _vh / 1000f;
        _zoom = 1f;
        _panX = 0f;
        _panY = 0f;
        _zones = ZoneStore.GetWorking(mapId);
        _selectedCustom = -1;
        _selectedBuiltin = null;
        _draggingZone = _panning = false;
    }

    private void ResetMap()
    {
        _zones = ZoneStore.ResetWorkingToDefault(_mapId);
        _selectedCustom = -1;
        _selectedBuiltin = null;
        Snackbar.Add("Zones reset to this map's shipped defaults.", Severity.Warning);
    }

    private void SelectBuiltin(string name)
    {
        _selectedBuiltin = name;
        _selectedCustom = -1;
    }

    private void SelectCustom(int index)
    {
        _selectedCustom = index;
        _selectedBuiltin = null;
    }

    /// <summary>BSG zones of this map (baked table) that have no tuning entry in the config yet.</summary>
    private IEnumerable<KeyValuePair<string, (float X, float Z)>> AvailableBuiltins()
        => BuiltinZonePositions.ZonesFor(_mapId) is { } zones
            ? zones.Where(kv => !_zones.BuiltinZones.ContainsKey(kv.Key))
            : Enumerable.Empty<KeyValuePair<string, (float X, float Z)>>();

    private void AddBuiltin(string name)
    {
        if (!_zones.BuiltinZones.ContainsKey(name))
            _zones.BuiltinZones[name] = new BuiltinZoneModel
            {
                Radius = new ZoneRange { Min = 150f, Max = 250f },
                Force = new ZoneRange { Min = 0.5f, Max = 1f },
                Decay = 1f,
            };
        SelectBuiltin(name);
    }

    private void RemoveBuiltinTuning()
    {
        if (_selectedBuiltin == null) return;
        _zones.BuiltinZones.Remove(_selectedBuiltin);
        _selectedBuiltin = null;
    }

    private string? HitTestAvailable(float wx, float wz)
    {
        string? best = null;
        var bestDist = float.MaxValue;
        foreach (var kv in AvailableBuiltins())
        {
            var dx = kv.Value.X - wx;
            var dz = kv.Value.Z - wz;
            var dist = MathF.Sqrt(dx * dx + dz * dz);
            if (dist <= 25f && dist < bestDist)
            {
                best = kv.Key;
                bestDist = dist;
            }
        }
        return best;
    }

    private void DeleteSelected()
    {
        if (_selectedCustom < 0 || _selectedCustom >= _zones.CustomZones.Count) return;
        _zones.CustomZones.RemoveAt(_selectedCustom);
        _selectedCustom = -1;
    }

    // ── pointer interactions (server-side hit testing, svg children are pointer-events:none) ──

    private void OnPointerDown(PointerEventArgs e)
    {
        _lastOx = e.OffsetX;
        _lastOy = e.OffsetY;
        if (e.Button == 1)
        {
            // Middle button: pan from anywhere, zones and selection untouched.
            _panning = true;
            _middlePan = true;
            return;
        }
        if (e.Button != 0) return;
        var (wx, wz) = OffsetToWorld(e.OffsetX, e.OffsetY);

        var customHit = HitTestCustom(wx, wz);
        if (customHit >= 0)
        {
            _selectedCustom = customHit;
            _selectedBuiltin = null;
            _draggingZone = true;
            var zone = _zones.CustomZones[customHit];
            _dragDx = zone.Position.X - wx;
            _dragDz = zone.Position.Y - wz;
            return;
        }

        var builtinHit = HitTestBuiltin(wx, wz);
        if (builtinHit != null)
        {
            _selectedBuiltin = builtinHit;
            _selectedCustom = -1;
            _panning = true; // built-ins don't move — dragging pans instead
            _panStartOx = e.OffsetX;
            _panStartOy = e.OffsetY;
            return;
        }

        var availableHit = HitTestAvailable(wx, wz);
        if (availableHit != null)
        {
            AddBuiltin(availableHit);
            return;
        }

        _selectedCustom = -1;
        _selectedBuiltin = null;
        _panning = true;
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (_draggingZone && _selectedCustom >= 0 && _selectedCustom < _zones.CustomZones.Count)
        {
            var (wx, wz) = OffsetToWorld(e.OffsetX, e.OffsetY);
            var zone = _zones.CustomZones[_selectedCustom];
            (zone.Position.X, zone.Position.Y) = ClampToWorld(MathF.Round(wx + _dragDx), MathF.Round(wz + _dragDz));
        }
        else if (_panning)
        {
            // Dragging a built-in pans (they can't move) — RC feedback showed nobody discovers that
            // from the hint text alone, so the first real drag attempt on one says it out loud.
            if (!_middlePan && !_builtinDragHintShown && _selectedBuiltin != null
                && Math.Abs(e.OffsetX - _panStartOx) + Math.Abs(e.OffsetY - _panStartOy) > 25)
            {
                _builtinDragHintShown = true;
                Snackbar.Add("Built-in zones sit where BSG placed them and cannot move (dragging pans the map). Their radius, force and decay are yours to tune. Need a hotspot elsewhere? Double-click empty ground to add a custom zone.", Severity.Info);
            }
            var f = 1000f / _zoom / CanvasW;
            _panX -= (float)(e.OffsetX - _lastOx) * f;
            _panY -= (float)(e.OffsetY - _lastOy) * f;
            ClampPan();
        }
        _lastOx = e.OffsetX;
        _lastOy = e.OffsetY;
    }

    private void OnPointerUp(PointerEventArgs e)
    {
        _draggingZone = false;
        _panning = false;
        _middlePan = false;
    }

    private void OnDoubleClick(MouseEventArgs e)
    {
        var (wx, wz) = OffsetToWorld(e.OffsetX, e.OffsetY);
        if (HitTestCustom(wx, wz) >= 0) return;
        var (ax, az) = ClampToWorld(MathF.Round(wx), MathF.Round(wz));
        _zones.CustomZones.Add(new CustomZoneModel { Position = new ZoneVec { X = ax, Y = az } });
        _selectedCustom = _zones.CustomZones.Count - 1;
        _selectedBuiltin = null;
    }

    private void OnWheel(WheelEventArgs e)
    {
        // Ctrl+wheel resizes the selected custom zone; plain wheel zooms the view at the cursor.
        if (e.CtrlKey && _selectedCustom >= 0 && _selectedCustom < _zones.CustomZones.Count)
        {
            var zone = _zones.CustomZones[_selectedCustom];
            var factor = e.DeltaY < 0 ? 1.08f : 1f / 1.08f;
            zone.Radius.Min = Math.Clamp(MathF.Round(zone.Radius.Min * factor), 10f, 2000f);
            zone.Radius.Max = Math.Clamp(MathF.Round(zone.Radius.Max * factor), zone.Radius.Min, 2000f);
            return;
        }

        var u = (float)(e.OffsetX / CanvasW);
        var v = (float)(e.OffsetY / _canvasH);
        var cx = _panX + u * 1000f / _zoom;
        var cy = _panY + v * _vh / _zoom;
        _zoom = Math.Clamp(_zoom * (e.DeltaY < 0 ? 1.2f : 1f / 1.2f), 0.4f, 10f);
        _panX = cx - u * 1000f / _zoom;
        _panY = cy - v * _vh / _zoom;
        ClampPan();
    }

    // Below x1 the viewport is LARGER than the map, so the pan bounds flip sign — this shared clamp
    // handles both regimes (zoomed-out views show the map with dark margins).
    private void ClampPan()
    {
        var freeX = 1000f - 1000f / _zoom;
        var freeY = _vh - _vh / _zoom;
        _panX = Math.Clamp(_panX, MathF.Min(0f, freeX), MathF.Max(0f, freeX));
        _panY = Math.Clamp(_panY, MathF.Min(0f, freeY), MathF.Max(0f, freeY));
    }

    private int HitTestCustom(float wx, float wz)
    {
        var best = -1;
        var bestDist = float.MaxValue;
        for (var i = 0; i < _zones.CustomZones.Count; i++)
        {
            var zone = _zones.CustomZones[i];
            var dx = zone.Position.X - wx;
            var dz = zone.Position.Y - wz;
            var dist = MathF.Sqrt(dx * dx + dz * dz);
            if (dist <= MathF.Max(zone.Radius.Max, 12f) && dist < bestDist)
            {
                best = i;
                bestDist = dist;
            }
        }
        return best;
    }

    private string? HitTestBuiltin(float wx, float wz)
    {
        string? best = null;
        var bestDist = float.MaxValue;
        foreach (var name in _zones.BuiltinZones.Keys)
        {
            if (!BuiltinZonePositions.TryGet(_mapId, name, out var pos)) continue;
            var bz = _zones.BuiltinZones[name];
            var dx = pos.X - wx;
            var dz = pos.Z - wz;
            var dist = MathF.Sqrt(dx * dx + dz * dz);
            if (dist <= MathF.Max(bz.Radius.Max, 20f) && dist < bestDist)
            {
                best = name;
                bestDist = dist;
            }
        }
        return best;
    }

    // ── world <-> view transforms (tarkov.dev convention: rotate, then fit the overlay bounds) ──

    private static (float x, float z) Rot(float x, float z, float deg) => MapViews.Rot(x, z, deg);

    private (float px, float py) WorldToView(float x, float z)
    {
        var (rx, rz) = Rot(x, z, _view.Rot);
        return ((rx - _minX) / _spanX * 1000f, (_maxZ - rz) / _spanZ * _vh);
    }

    private (float x, float z) ViewToWorld(float px, float py)
    {
        var rx = _minX + px / 1000f * _spanX;
        var rz = _maxZ - py / _vh * _spanZ;
        return Rot(rx, rz, -_view.Rot);
    }

    private (float x, float z) OffsetToWorld(double offsetX, double offsetY)
    {
        var px = _panX + (float)(offsetX / CanvasW) * 1000f / _zoom;
        var py = _panY + (float)(offsetY / _canvasH) * _vh / _zoom;
        return ViewToWorld(px, py);
    }

    private float MetersToView(float meters) => meters / _spanX * 1000f;

    private (float x, float z) ClampToWorld(float x, float z) => (
        Math.Clamp(x, MathF.Min(_view.X1, _view.X2), MathF.Max(_view.X1, _view.X2)),
        Math.Clamp(z, MathF.Min(_view.Z1, _view.Z2), MathF.Max(_view.Z1, _view.Z2)));

    private static string F(float v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    /// <summary>
    /// Non-null when the force range is centered around zero (midpoint within a tenth of the range's width).
    /// The per-raid roll is a gaussian on the midpoint with sigma = a sixth of the range, so about 68% of raids
    /// land in the middle third: with the midpoint on zero the zone barely pulls or pushes most raids, whatever
    /// its radius. Shown as an icon in the zone list and in full on the selected zone's card.
    /// </summary>
    private static string? ForceCenteredOnZeroWarning(ZoneRange force)
    {
        var min = MathF.Min(force.Min, force.Max);
        var max = MathF.Max(force.Min, force.Max);
        var width = max - min;
        var mid = (min + max) * 0.5f;
        if (width < 0.001f)
            return MathF.Abs(mid) < 0.005f ? "Force is 0: this zone does nothing." : null;
        if (MathF.Abs(mid) > width * 0.1f) return null;
        var lo = (min + width / 3f).ToString("0.00", CultureInfo.InvariantCulture);
        var hi = (max - width / 3f).ToString("0.00", CultureInfo.InvariantCulture);
        return $"Force range centered around 0: the roll is gaussian, so about 68% of raids land between {lo} and {hi} and the zone barely pulls or pushes. Shift the range if you want it to act every raid, for example 0.2 / 0.8 instead of -0.3 / 0.3.";
    }

    // ── decay heatmap ──
    // One zone's force only depends on the distance to its center: clamp01(1 - d/R) ^ (decay * falloffScale).
    // A radial gradient whose stops are sampled from that curve IS the heatmap, exact and nearly free to
    // draw (one circle per zone instead of a grid of cells). Color = share of the zone's own force left at
    // that distance, so the shape of the fade reads the same on a weak zone and on a strong one.

    private const int HeatStops = 18;

    private static readonly (float T, int R, int G, int B)[] PullRamp =
    [
        (0f, 0x2C, 0x3E, 0x90), (0.25f, 0x2B, 0xB3, 0xC0), (0.5f, 0x7B, 0xD8, 0x8F), (0.75f, 0xFF, 0xD4, 0x54), (1f, 0xFF, 0x6B, 0x3D),
    ];

    private static readonly (float T, int R, int G, int B)[] PushRamp =
    [
        (0f, 0x2A, 0x1E, 0x5A), (0.35f, 0x6D, 0x3A, 0xA8), (0.7f, 0xC0, 0x47, 0x9B), (1f, 0xFF, 0x7A, 0xA2),
    ];

    private static string RampColor((float T, int R, int G, int B)[] ramp, float t)
    {
        t = Math.Clamp(t, 0f, 1f);
        for (var i = 1; i < ramp.Length; i++)
        {
            if (t > ramp[i].T) continue;
            var a = ramp[i - 1];
            var b = ramp[i];
            var k = (t - a.T) / MathF.Max(0.0001f, b.T - a.T);
            return $"#{(int)MathF.Round(a.R + (b.R - a.R) * k):X2}{(int)MathF.Round(a.G + (b.G - a.G) * k):X2}{(int)MathF.Round(a.B + (b.B - a.B) * k):X2}";
        }
        var last = ramp[^1];
        return $"#{last.R:X2}{last.G:X2}{last.B:X2}";
    }

    private static string HeatCss(bool push)
    {
        var ramp = push ? PushRamp : PullRamp;
        return string.Join(", ", ramp.Select(stop => $"{RampColor(ramp, stop.T)} {F(stop.T * 100f)}%"));
    }

    private string HeatLayer()
    {
        var zs = new List<(float X, float Z, float R, float Fo, float D)>();
        var anySelected = _selectedBuiltin != null || (_selectedCustom >= 0 && _selectedCustom < _zones.CustomZones.Count);
        foreach (var kv in _zones.BuiltinZones)
        {
            if (anySelected && kv.Key != _selectedBuiltin) continue;
            if (!BuiltinZonePositions.TryGet(_mapId, kv.Key, out var pos)) continue;
            zs.Add((pos.X, pos.Z, (kv.Value.Radius.Min + kv.Value.Radius.Max) * 0.5f, (kv.Value.Force.Min + kv.Value.Force.Max) * 0.5f, kv.Value.Decay));
        }
        for (var i = 0; i < _zones.CustomZones.Count; i++)
        {
            if (anySelected && i != _selectedCustom) continue;
            var cz = _zones.CustomZones[i];
            zs.Add((cz.Position.X, cz.Position.Y, (cz.Radius.Min + cz.Radius.Max) * 0.5f, (cz.Force.Min + cz.Force.Max) * 0.5f, cz.Decay));
        }
        if (zs.Count == 0) return "";

        var cfg = Configs.Config.Zones;
        var peakOpacity = anySelected ? 0.62f : 0.42f; // several overlapping zones must not bury the map
        var defs = new StringBuilder("<defs>");
        var shapes = new StringBuilder();
        for (var n = 0; n < zs.Count; n++)
        {
            var z = zs[n];
            var radius = MetersToView(z.R * cfg.ZoneRadiusScale);
            if (radius <= 0.01f) continue;
            var exponent = MathF.Max(0.01f, z.D * cfg.ZoneFalloffScale);
            var ramp = z.Fo * cfg.ZoneForceScale < 0f ? PushRamp : PullRamp;
            var (px, py) = WorldToView(z.X, z.Z);
            defs.Append($"<radialGradient id=\"orbit-heat-{n}\" gradientUnits=\"userSpaceOnUse\" cx=\"{F(px)}\" cy=\"{F(py)}\" r=\"{F(radius)}\">");
            for (var i = 0; i <= HeatStops; i++)
            {
                var t = i / (float)HeatStops;
                var share = MathF.Pow(1f - t, exponent);
                var opacity = i == HeatStops ? 0f : peakOpacity * (0.18f + 0.82f * share);
                defs.Append($"<stop offset=\"{F(t)}\" stop-color=\"{RampColor(ramp, share)}\" stop-opacity=\"{F(opacity)}\" />");
            }
            defs.Append("</radialGradient>");
            shapes.Append($"<circle cx=\"{F(px)}\" cy=\"{F(py)}\" r=\"{F(radius)}\" fill=\"url(#orbit-heat-{n})\" />");
        }
        return defs.Append("</defs>").Append(shapes).ToString();
    }

    /// <summary>
    /// Arrow overlay previewing the advection pull. Mirrors WaypointSystem's per-cell formula
    /// (clamp01(1 - dist/(radius*scale)) ^ (decay*falloffScale) * force*forceScale, summed over zones,
    /// pointing toward each zone) with min/max ranges collapsed to their midpoint. The grid follows the
    /// current viewport so on-screen density stays constant at any zoom (~900 cells, recomputed per render:
    /// cheap, and it makes the arrows react live while a slider is being dragged).
    /// </summary>
    private IEnumerable<string> FieldArrowPaths()
    {
        // Selected zone only: a full-map field over every zone reads as noise, one zone's pull is legible.
        var zs = new List<(float X, float Z, float R, float Fo, float D)>();
        if (_selectedBuiltin != null && _zones.BuiltinZones.TryGetValue(_selectedBuiltin, out var sbz)
            && BuiltinZonePositions.TryGet(_mapId, _selectedBuiltin, out var bpos))
        {
            zs.Add((bpos.X, bpos.Z, (sbz.Radius.Min + sbz.Radius.Max) * 0.5f,
                    (sbz.Force.Min + sbz.Force.Max) * 0.5f, sbz.Decay));
        }
        else if (_selectedCustom >= 0 && _selectedCustom < _zones.CustomZones.Count)
        {
            var cz = _zones.CustomZones[_selectedCustom];
            zs.Add((cz.Position.X, cz.Position.Y, (cz.Radius.Min + cz.Radius.Max) * 0.5f,
                    (cz.Force.Min + cz.Force.Max) * 0.5f, cz.Decay));
        }
        if (zs.Count == 0) yield break;

        var cfg = Configs.Config.Zones;
        var step = 30f / _zoom;
        var yEnd = _panY + _vh / _zoom;
        var xEnd = _panX + 1000f / _zoom;
        for (var vy = _panY + step * 0.5f; vy < yEnd; vy += step)
        {
            for (var vx = _panX + step * 0.5f; vx < xEnd; vx += step)
            {
                var (wx, wz) = ViewToWorld(vx, vy);
                float fx = 0f, fz = 0f;
                foreach (var z in zs)
                {
                    var dx = z.X - wx;
                    var dz = z.Z - wz;
                    var dist = MathF.Sqrt(dx * dx + dz * dz);
                    if (dist < 0.001f) continue;
                    var t = 1f - dist / (z.R * cfg.ZoneRadiusScale);
                    if (t <= 0f) continue;
                    var f = MathF.Pow(t, z.D * cfg.ZoneFalloffScale) * z.Fo * cfg.ZoneForceScale;
                    fx += f * dx / dist;
                    fz += f * dz / dist;
                }
                var mag = MathF.Sqrt(fx * fx + fz * fz);
                if (mag < 0.03f) continue;

                // World direction -> view direction (map rotation + the vertical flip of WorldToView).
                var (rx, rz) = Rot(fx, fz, _view.Rot);
                var vdx = rx / _spanX * 1000f;
                var vdy = -rz / _spanZ * _vh;
                var vlen = MathF.Sqrt(vdx * vdx + vdy * vdy);
                if (vlen < 0.0001f) continue;
                vdx /= vlen;
                vdy /= vlen;

                var len = MathF.Min(5f + mag * 8f, 13f) / _zoom;
                var tx = vx + vdx * len;
                var ty = vy + vdy * len;
                var hb = 3f / _zoom;
                var bx = tx - vdx * hb;
                var by = ty - vdy * hb;
                var hx = -vdy * hb;
                var hy = vdx * hb;
                var op = Math.Clamp(0.2f + mag * 0.45f, 0.2f, 0.85f);
                yield return $"<path d=\"M {F(vx)} {F(vy)} L {F(tx)} {F(ty)} M {F(bx + hx)} {F(by + hy)} L {F(tx)} {F(ty)} L {F(bx - hx)} {F(by - hy)}\" stroke=\"#E8C170\" stroke-opacity=\"{F(op)}\" stroke-width=\"{F(1.1f / _zoom)}\" fill=\"none\" />";
            }
        }
    }

    // ── zone packs (export / import) ──

    private string _packName = "";
    private string _packAuthor = "";
    private string _packDescription = "";
    private bool _exportAllMaps;
    private string? _exportHref;
    private string? _exportFileName;
    private string? _importSummary;

    private void GeneratePack()
    {
        var maps = _exportAllMaps ? ZoneStoreService.MapIds : new[] { _mapId };
        var name = string.IsNullOrWhiteSpace(_packName)
            ? (_exportAllMaps ? "orbit-zones" : $"orbit-zones-{ZoneStoreService.MapLabels[_mapId]}")
            : _packName;
        var json = ZoneStore.ExportPack(maps, name, _packAuthor, _packDescription);
        var slug = new string(name.Trim().ToLowerInvariant()
            .Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray()).Trim('-');
        if (slug.Length == 0) slug = "orbit-zones";
        _exportFileName = slug + ".orbitzones.json";
        _exportHref = "data:application/json;base64," + Convert.ToBase64String(Encoding.UTF8.GetBytes(json));
    }

    private async Task ImportPackFile(IBrowserFile? file)
    {
        if (file == null) return;
        try
        {
            using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 5_000_000));
            var json = await reader.ReadToEndAsync();
            var (applied, skipped) = ZoneStore.ImportPack(json);
            var appliedLabels = string.Join(", ", applied.Select(id => ZoneStoreService.MapLabels.TryGetValue(id, out var l) ? l : id));
            _importSummary = applied.Count == 0
                ? "Nothing importable in that file."
                : $"Imported {applied.Count} map(s): {appliedLabels}."
                  + (skipped.Count > 0 ? $" Skipped unknown: {string.Join(", ", skipped)}." : "");
            if (applied.Count > 0)
                Snackbar.Add($"Pack imported ({applied.Count} maps) as unsaved changes — review, then Save.", Severity.Success);
        }
        catch (Exception ex)
        {
            _importSummary = $"Import failed: {ex.Message}";
            Snackbar.Add("Pack import failed — is this a .orbitzones.json file?", Severity.Error);
        }
    }
}
