@page "/orbit/zone-editor"
@layout Orbit.Server.Web.Shared.MainLayout
@implements IDisposable
@using System.Globalization
@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@using Orbit.Server.Zones
@using Orbit.Server.Config
@inject ZoneStoreService ZoneStore
@inject ConfigService Configs
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>ORBIT: Zone editor</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <div class="d-flex align-center mb-1 flex-wrap" style="gap:12px">
        <MudText Typo="Typo.h5">Zone editor</MudText>
        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">New in 2.0</MudChip>
        <MudSpacer />
        <MudSelect T="string" Value="_mapId" ValueChanged="LoadMap" Label="Map" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="min-width:220px">
            @foreach (var id in ZoneStoreService.MapIds)
            {
                <MudSelectItem T="string" Value="@id">@ZoneStoreService.MapLabels[id]</MudSelectItem>
            }
        </MudSelect>
        <MudTooltip Text="Preview of the selected zone's pull. Arrows point where squads get nudged; length and brightness show strength. Uses the middle of the zone's min/max ranges." Arrow="true">
            <MudSwitch T="bool" @bind-Value="_showField" Color="Color.Primary" Size="Size.Small" Label="Pull field" />
        </MudTooltip>
        <MudTooltip Text="Heatmap of how each zone's force fades from its center to its edge, which is what Decay shapes: the color is the share of the zone's force left at that distance. Shows the selected zone, or every zone when nothing is selected. Uses the middle of the min/max ranges." Arrow="true">
            <MudSwitch T="bool" @bind-Value="_showHeat" Color="Color.Primary" Size="Size.Small" Label="Decay heatmap" />
        </MudTooltip>
        @if (ZoneStoreService.SiblingOf(_mapId) is { } siblingId)
        {
            <MudTooltip Text="@($"Overwrites the zones of {ZoneStoreService.MapLabels[siblingId]} with a copy of the ones on screen. Lands as unsaved changes there: review, then Save (or undo).")" Arrow="true">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="@(() => CopyToSibling(siblingId))">Copy to @ZoneStoreService.MapLabels[siblingId]</MudButton>
            </MudTooltip>
        }
        <MudTooltip Text="Restore this map's shipped default zones (writes them immediately)." Arrow="true">
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetMap">Reset map</MudButton>
        </MudTooltip>
    </div>
    <MudText Typo="Typo.body2" Class="mb-3" Style="opacity:.6">
        Hotspots pull (teal) or push (red) squad routing. <b>Click</b> selects, <b>drag</b> moves a custom zone
        (dragging empty ground pans, and so does the <b>middle mouse button</b> anywhere, without touching the
        selection), <b>wheel</b> zooms, <b>Ctrl+wheel</b> resizes the selection,
        <b>double-click</b> adds a zone. Dashed ring = max radius, solid = min (sampled per raid).
        Built-in zones (labelled) sit where BSG put them — tune them, they cannot move. Grey dots are
        BSG zones without a tuning entry yet: click one (map or list) to start tuning it. Edits ride the
        global Unsaved changes / Save button and apply from the next raid. Map render courtesy of tarkov.dev.
    </MudText>

    <div class="d-flex flex-wrap" style="gap:16px; align-items:flex-start">
    @* The canvas keeps its EXACT pixel size (scroll horizontally on narrow windows): a CSS-shrunk
       canvas breaks the offset->world math and makes drags crawl behind the cursor. *@
    <div style="max-width:100%; overflow-x:auto; flex-shrink:1">
    @* user-select:none + dragstart preventDefault: without them a drag natively SELECTS the svg
       labels behind (visible highlight), and the NEXT drag starting inside that selection becomes a
       browser drag-of-selection that cancels our pointer events — the RC "second drag does nothing"
       report. Synthetic-event tests can't reproduce it, only real mouse gestures do. *@
    <div id="orbit-zone-pad" style="position:relative; width:@(CanvasW)px; height:@F(_canvasH)px; background:#0A0E17; border:1px solid #222B3E; border-radius:10px; overflow:hidden; touch-action:none; user-select:none; -webkit-user-select:none; cursor:@CursorStyle"
         @onpointerdown="OnPointerDown" @onpointermove="OnPointerMove" @onpointerup="OnPointerUp"
         @onpointerleave="OnPointerUp" @ondblclick="OnDoubleClick"
         @ondragstart:preventDefault="true"
         @onwheel="OnWheel" @onwheel:preventDefault="true">
        <svg id="orbit-zone-canvas" viewBox="@F(_panX) @F(_panY) @F(1000f / _zoom) @F(_vh / _zoom)" preserveAspectRatio="none"
             style="position:absolute; inset:0; width:100%; height:100%">
            <style>#orbit-zone-canvas circle, #orbit-zone-canvas line, #orbit-zone-canvas path, #orbit-zone-canvas text, #orbit-zone-canvas image { pointer-events: none; }</style>
            @if (_inlineSvg != null)
            {
                @((MarkupString)MapRenders.Wrap(_inlineSvg, _vh))
            }
            else if (_view.Svg != null)
            {
                <image href="@_view.Svg" x="0" y="0" width="1000" height="@F(_vh)" preserveAspectRatio="none" opacity="0.85" />
            }
            else
            {
                @for (var g = 1; g < 10; g++)
                {
                    <line x1="@F(g * 100)" y1="0" x2="@F(g * 100)" y2="@F(_vh)" stroke="#222B3E" stroke-width="@F(0.8f / _zoom)" />
                    <line x1="0" y1="@F(_vh * g / 10f)" x2="1000" y2="@F(_vh * g / 10f)" stroke="#222B3E" stroke-width="@F(0.8f / _zoom)" />
                }
            }
            @if (_showHeat)
            {
                @((MarkupString)HeatLayer())
            }
            @if (_showField && !_panning && !_draggingZone)
            {
                @* Live preview of the advection pull — same formula as WaypointSystem, min/max ranges
                   collapsed to their midpoint. Hidden while panning/dragging to keep interactions snappy. *@
                @((MarkupString)string.Concat(FieldArrowPaths()))
            }
            @foreach (var name in _zones.BuiltinZones.Keys)
            {
                if (!BuiltinZonePositions.TryGet(_mapId, name, out var pos)) continue;
                var bz = _zones.BuiltinZones[name];
                var (px, py) = WorldToView(pos.X, pos.Z);
                var color = (bz.Force.Min + bz.Force.Max) * 0.5f >= 0f ? "#4FD1C5" : "#FF6B6B";
                var selected = _selectedBuiltin == name || _hoverBuiltin == name;
                <circle cx="@F(px)" cy="@F(py)" r="@F(MetersToView(bz.Radius.Max))" fill="@color" fill-opacity="0.05"
                        stroke="@(selected ? "#FFB454" : color)" stroke-opacity="@(selected ? "0.9" : "0.3")"
                        stroke-width="@F((selected ? 2.2f : 1.1f) / _zoom)" stroke-dasharray="2 3" />
                <circle cx="@F(px)" cy="@F(py)" r="@F(MetersToView(bz.Radius.Min))" fill="@color" fill-opacity="0.10"
                        stroke="@(selected ? "#FFB454" : color)" stroke-opacity="@(selected ? "0.9" : "0.45")"
                        stroke-width="@F((selected ? 1.8f : 1.1f) / _zoom)" stroke-dasharray="2 3" />
                @* razor reserves <text>, so the svg label goes through MarkupString *@
                @((MarkupString)$"<text x=\"{F(px)}\" y=\"{F(py - MetersToView(bz.Radius.Min) - 4f / _zoom)}\" text-anchor=\"middle\" font-size=\"{F(10f / _zoom)}\" fill=\"{(selected ? "#FFB454" : "#9AA4B8")}\" opacity=\"0.9\">{System.Net.WebUtility.HtmlEncode(name)}</text>")
                <circle cx="@F(px)" cy="@F(py)" r="@F(2.5f / _zoom)" fill="@(selected ? "#FFB454" : color)" />
            }
            @foreach (var kv in AvailableBuiltins())
            {
                var (apx, apy) = WorldToView(kv.Value.X, kv.Value.Z);
                <circle cx="@F(apx)" cy="@F(apy)" r="@F(3f / _zoom)" fill="#8A94A8" opacity="0.55" />
                <circle cx="@F(apx)" cy="@F(apy)" r="@F(8f / _zoom)" fill="none" stroke="#8A94A8" stroke-width="@F(1f / _zoom)" opacity="0.35" stroke-dasharray="2 2" />
                @((MarkupString)$"<text x=\"{F(apx)}\" y=\"{F(apy - 12f / _zoom)}\" text-anchor=\"middle\" font-size=\"{F(9f / _zoom)}\" fill=\"#8A94A8\" opacity=\"0.5\">{System.Net.WebUtility.HtmlEncode(kv.Key)}</text>")
            }
            @for (var i = 0; i < _zones.CustomZones.Count; i++)
            {
                var zone = _zones.CustomZones[i];
                var (px, py) = WorldToView(zone.Position.X, zone.Position.Y);
                var color = (zone.Force.Min + zone.Force.Max) * 0.5f >= 0f ? "#4FD1C5" : "#FF6B6B";
                var selected = i == _selectedCustom || i == _hoverCustom;
                <circle cx="@F(px)" cy="@F(py)" r="@F(MetersToView(zone.Radius.Max))" fill="@color" fill-opacity="0.08"
                        stroke="@(selected ? "#FFB454" : color)" stroke-opacity="@(selected ? "0.9" : "0.35")"
                        stroke-width="@F((selected ? 2.2f : 1.1f) / _zoom)" stroke-dasharray="6 5" />
                <circle cx="@F(px)" cy="@F(py)" r="@F(MetersToView(zone.Radius.Min))" fill="@color" fill-opacity="0.14"
                        stroke="@(selected ? "#FFB454" : color)" stroke-opacity="@(selected ? "0.9" : "0.55")"
                        stroke-width="@F((selected ? 1.8f : 1.1f) / _zoom)" />
                @if (!string.IsNullOrWhiteSpace(zone.Name))
                {
                    @((MarkupString)$"<text x=\"{F(px)}\" y=\"{F(py - MetersToView(zone.Radius.Min) - 4f / _zoom)}\" text-anchor=\"middle\" font-size=\"{F(10f / _zoom)}\" fill=\"{(selected ? "#FFB454" : "#9AA4B8")}\" opacity=\"0.9\">{System.Net.WebUtility.HtmlEncode(zone.Name)}</text>")
                }
                <circle cx="@F(px)" cy="@F(py)" r="@F(3f / _zoom)" fill="@(selected ? "#FFB454" : color)" />
            }
        </svg>
        @if (_view.Svg == null)
        {
            <MudText Typo="Typo.caption" Style="position:absolute; top:8px; left:12px; opacity:.5; pointer-events:none">No public map render for this location — zones stay fully editable on the grid.</MudText>
        }
        @if (_showHeat)
        {
            <div style="position:absolute; bottom:6px; left:10px; pointer-events:none; font-size:.68rem; color:#9AA4B8; display:flex; align-items:center; gap:6px">
                <span>edge 0%</span>
                <span style="display:inline-flex; flex-direction:column; gap:2px">
                    <span title="attracting zone" style="width:120px; height:6px; border-radius:3px; background:linear-gradient(90deg, @HeatCss(false))"></span>
                    <span title="repelling zone" style="width:120px; height:6px; border-radius:3px; background:linear-gradient(90deg, @HeatCss(true))"></span>
                </span>
                <span>100% center</span>
                <span style="opacity:.6">top: pull, bottom: push</span>
            </div>
        }
        <MudText Typo="Typo.caption" Style="position:absolute; bottom:6px; right:10px; opacity:.4; pointer-events:none">@($"zoom x{_zoom:0.#}")</MudText>
    </div>
    </div>

    <div style="width:280px; max-height:@F(_canvasH)px; overflow-y:auto; border:1px solid #222B3E; border-radius:10px; padding:8px 6px; background:#0E1420">
        <MudText Typo="Typo.subtitle2" Class="px-2 mb-1" Style="opacity:.7">Zones (@(_zones.BuiltinZones.Count + _zones.CustomZones.Count))</MudText>
        @foreach (var name in _zones.BuiltinZones.Keys.OrderBy(n => n, StringComparer.OrdinalIgnoreCase))
        {
            var rowName = name;
            var bz = _zones.BuiltinZones[rowName];
            var rowColor = (bz.Force.Min + bz.Force.Max) * 0.5f >= 0f ? "#4FD1C5" : "#FF6B6B";
            var rowSelected = _selectedBuiltin == rowName;
            var unplacedRow = !BuiltinZonePositions.TryGet(_mapId, rowName, out _);
            <div @onmouseover="@(() => _hoverBuiltin = rowName)" @onmouseout="@(() => _hoverBuiltin = null)"
                 @onclick="@(() => SelectBuiltin(rowName))"
                 style="display:flex; align-items:center; gap:8px; padding:4px 8px; border-radius:6px; cursor:pointer; background:@(rowSelected ? "rgba(255,180,84,.12)" : _hoverBuiltin == rowName ? "rgba(255,255,255,.05)" : "transparent")">
                <span style="width:9px; height:9px; border-radius:50%; background:@rowColor; flex-shrink:0"></span>
                <span style="font-size:.83rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap">@rowName</span>
                @if (ForceCenteredOnZeroWarning(bz.Force) is { } rowWarning)
                {
                    <span title="@rowWarning" style="margin-left:auto; color:#FFB454; font-size:.8rem; flex-shrink:0">&#9888;</span>
                }
                <span style="margin-left:@(ForceCenteredOnZeroWarning(bz.Force) == null ? "auto" : "6px"); font-size:.72rem; opacity:.5; flex-shrink:0">@(unplacedRow ? "?" : $"{bz.Radius.Min:F0}-{bz.Radius.Max:F0}m")</span>
            </div>
        }
        @for (var i = 0; i < _zones.CustomZones.Count; i++)
        {
            var rowIdx = i;
            var zone = _zones.CustomZones[rowIdx];
            var rowColor = (zone.Force.Min + zone.Force.Max) * 0.5f >= 0f ? "#4FD1C5" : "#FF6B6B";
            var rowSelected = _selectedCustom == rowIdx;
            <div @onmouseover="@(() => _hoverCustom = rowIdx)" @onmouseout="@(() => _hoverCustom = -1)"
                 @onclick="@(() => SelectCustom(rowIdx))"
                 style="display:flex; align-items:center; gap:8px; padding:4px 8px; border-radius:6px; cursor:pointer; background:@(rowSelected ? "rgba(255,180,84,.12)" : _hoverCustom == rowIdx ? "rgba(255,255,255,.05)" : "transparent")">
                <span style="width:9px; height:9px; border-radius:50%; background:@rowColor; border:1px dashed #E6EAF2; flex-shrink:0"></span>
                <span style="font-size:.83rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap">@CustomLabel(rowIdx)</span>
                @if (ForceCenteredOnZeroWarning(zone.Force) is { } rowWarning)
                {
                    <span title="@rowWarning" style="margin-left:auto; color:#FFB454; font-size:.8rem; flex-shrink:0">&#9888;</span>
                }
                <span style="margin-left:@(ForceCenteredOnZeroWarning(zone.Force) == null ? "auto" : "6px"); font-size:.72rem; opacity:.5; flex-shrink:0">@($"{zone.Radius.Min:F0}-{zone.Radius.Max:F0}m")</span>
            </div>
        }
        @if (AvailableBuiltins().Any())
        {
            <MudText Typo="Typo.subtitle2" Class="px-2 mt-2 mb-1" Style="opacity:.5">Not tuned yet — click to add</MudText>
            @foreach (var kv in AvailableBuiltins().OrderBy(k => k.Key, StringComparer.OrdinalIgnoreCase))
            {
                var availName = kv.Key;
                <div @onclick="@(() => AddBuiltin(availName))"
                     style="display:flex; align-items:center; gap:8px; padding:3px 8px; border-radius:6px; cursor:pointer; opacity:.55">
                    <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Style="font-size:15px" />
                    <span style="font-size:.8rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap">@availName</span>
                </div>
            }
        }
    </div>
    </div>

    @if (_selectedCustom >= 0 && _selectedCustom < _zones.CustomZones.Count)
    {
        var sel = _zones.CustomZones[_selectedCustom];
        <SettingsCard Title="@($"{(string.IsNullOrWhiteSpace(sel.Name) ? "Custom zone" : sel.Name)} — ({sel.Position.X:F0}, {sel.Position.Y:F0})")">
            <MudTextField T="string" Value="@sel.Name" ValueChanged="@(v => sel.Name = string.IsNullOrEmpty(v) ? null : v)"
                          Label="Name" Placeholder="@($"Custom {_selectedCustom + 1}")" MaxLength="40" Immediate="true"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Style="max-width:340px"
                          HelperText="Only for you: shown on the map, in the list and in exported packs. The game ignores it." />
            <OrbitSlider T="float" @bind-Value="sel.Radius.Min" Label="Radius min" Unit="m" Min="10f" Max="2000f" Step="1f" Fmt="0"
                         Tooltip="Rolled once per raid between min and max with a gaussian: about 68% of raids land in the middle third of the range, 95% in the middle two thirds, the edges are rare. The circle on the map is NOT the size of the zone: the zone is its center point, the radius is how far out squads start getting pulled toward it, and outside the circle the zone does nothing. A wide range changes the reach a lot from raid to raid; set min close to max for a consistent reach." />
            <OrbitSlider T="float" @bind-Value="sel.Radius.Max" Label="Radius max" Unit="m" Min="10f" Max="2000f" Step="1f" Fmt="0"
                         Tooltip="Rolled once per raid between min and max with a gaussian: about 68% of raids land in the middle third of the range, 95% in the middle two thirds, the edges are rare. The circle on the map is NOT the size of the zone: the zone is its center point, the radius is how far out squads start getting pulled toward it, and outside the circle the zone does nothing. A wide range changes the reach a lot from raid to raid; set min close to max for a consistent reach." />
            <OrbitSlider T="float" @bind-Value="sel.Force.Min" Label="Force min" Min="-10f" Max="10f" Step="0.05f" Fmt="0.00"
                         Tooltip="Rolled once per raid between min and max with a gaussian: about 68% of raids land in the middle third of the range, 95% in the middle two thirds, the edges are rare. Positive attracts squads, negative repels them. A range centered on zero (like -0.3 / 0.3) is a zone that does nothing most raids: shift it instead. -0.5 / 1.5 pulls at roughly +0.5 most raids, hard in about 2% of raids, and repels in about 7% (1 raid in 15)." />
            <OrbitSlider T="float" @bind-Value="sel.Force.Max" Label="Force max" Min="-10f" Max="10f" Step="0.05f" Fmt="0.00"
                         Tooltip="Rolled once per raid between min and max with a gaussian: about 68% of raids land in the middle third of the range, 95% in the middle two thirds, the edges are rare. Positive attracts squads, negative repels them. A range centered on zero (like -0.3 / 0.3) is a zone that does nothing most raids: shift it instead. -0.5 / 1.5 pulls at roughly +0.5 most raids, hard in about 2% of raids, and repels in about 7% (1 raid in 15)." />
            @if (ForceCenteredOnZeroWarning(sel.Force) is { } selForceWarning)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1 mb-2">@selForceWarning</MudAlert>
            }
            <OrbitSlider T="float" @bind-Value="sel.Decay" Label="Decay" Min="0.1f" Max="8f" Step="0.1f" Fmt="0.0"
                         Tooltip="How the pull fades from center to edge. 1 = linear. Below 1 = stays strong almost all the way to the edge. Above 1 = squeezed into the center, the rest of the zone barely attracts." />
            <OrbitSwitch @bind-Value="sel.KillMains" Label="Kill-main anchor"
                         Tooltip="ON (default): squads rolling a Kills main objective can pick this zone as their hunting ground (only zones with a positive force qualify). OFF: the zone only steers routing — a pure hotspot, never a kill arena." />
            <div class="mt-2"></div>
            <MudTooltip Text="New custom zone with the same radius, force, decay and kill-main setting, placed next to this one and selected: drag it where you want it." Arrow="true">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.ContentCopy" Class="mr-2" OnClick="DuplicateSelected">Duplicate zone</MudButton>
            </MudTooltip>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteSelected">Delete zone</MudButton>
        </SettingsCard>
    }
    else if (_selectedBuiltin != null && _zones.BuiltinZones.TryGetValue(_selectedBuiltin, out var selBz))
    {
        <SettingsCard Title="@($"Built-in zone — {_selectedBuiltin}")"
                      Subtitle="Position comes from the game (BSG spawn zone) and cannot move; radius, force and decay are yours.">
            <OrbitSlider T="float" @bind-Value="selBz.Radius.Min" Label="Radius min" Unit="m" Min="10f" Max="2000f" Step="1f" Fmt="0"
                         Tooltip="Rolled once per raid between min and max with a gaussian: about 68% of raids land in the middle third of the range, 95% in the middle two thirds, the edges are rare. The circle on the map is NOT the size of the zone: the zone is its center point, the radius is how far out squads start getting pulled toward it, and outside the circle the zone does nothing. A wide range changes the reach a lot from raid to raid; set min close to max for a consistent reach." />
            <OrbitSlider T="float" @bind-Value="selBz.Radius.Max" Label="Radius max" Unit="m" Min="10f" Max="2000f" Step="1f" Fmt="0"
                         Tooltip="Rolled once per raid between min and max with a gaussian: about 68% of raids land in the middle third of the range, 95% in the middle two thirds, the edges are rare. The circle on the map is NOT the size of the zone: the zone is its center point, the radius is how far out squads start getting pulled toward it, and outside the circle the zone does nothing. A wide range changes the reach a lot from raid to raid; set min close to max for a consistent reach." />
            <OrbitSlider T="float" @bind-Value="selBz.Force.Min" Label="Force min" Min="-10f" Max="10f" Step="0.05f" Fmt="0.00"
                         Tooltip="Rolled once per raid between min and max with a gaussian: about 68% of raids land in the middle third of the range, 95% in the middle two thirds, the edges are rare. Positive attracts squads, negative repels them. A range centered on zero (like -0.3 / 0.3) is a zone that does nothing most raids: shift it instead. -0.5 / 1.5 pulls at roughly +0.5 most raids, hard in about 2% of raids, and repels in about 7% (1 raid in 15)." />
            <OrbitSlider T="float" @bind-Value="selBz.Force.Max" Label="Force max" Min="-10f" Max="10f" Step="0.05f" Fmt="0.00"
                         Tooltip="Rolled once per raid between min and max with a gaussian: about 68% of raids land in the middle third of the range, 95% in the middle two thirds, the edges are rare. Positive attracts squads, negative repels them. A range centered on zero (like -0.3 / 0.3) is a zone that does nothing most raids: shift it instead. -0.5 / 1.5 pulls at roughly +0.5 most raids, hard in about 2% of raids, and repels in about 7% (1 raid in 15)." />
            @if (ForceCenteredOnZeroWarning(selBz.Force) is { } selBzForceWarning)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1 mb-2">@selBzForceWarning</MudAlert>
            }
            <OrbitSlider T="float" @bind-Value="selBz.Decay" Label="Decay" Min="0.1f" Max="8f" Step="0.1f" Fmt="0.0"
                         Tooltip="How the pull fades from center to edge. 1 = linear. Below 1 = stays strong almost all the way to the edge. Above 1 = squeezed into the center, the rest of the zone barely attracts." />
            <OrbitSwitch @bind-Value="selBz.KillMains" Label="Kill-main anchor"
                         Tooltip="ON (default): squads rolling a Kills main objective can pick this zone as their hunting ground (only zones with a positive force qualify). OFF: the zone only steers routing — a pure hotspot, never a kill arena." />
            <div class="mt-2"></div>
            <MudTooltip Text="New CUSTOM zone with the same radius, force, decay and kill-main setting, placed next to this one and selected. Built-in zones cannot move, the copy can." Arrow="true">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.ContentCopy" Class="mr-2" OnClick="DuplicateSelected">Duplicate as custom zone</MudButton>
            </MudTooltip>
            <MudTooltip Text="Remove this zone's tuning entry — ORBIT will then ignore this BSG zone entirely. It goes back to the 'not tuned yet' list." Arrow="true">
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Delete" OnClick="RemoveBuiltinTuning">Remove tuning</MudButton>
            </MudTooltip>
        </SettingsCard>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mt-3" Style="opacity:.45">Nothing selected — click a zone on the map, or double-click empty ground to add a custom hotspot.</MudText>
    }

    <SettingsCard Title="Share zone packs"
                  Subtitle="Export your hotspot setup as a single .json pack to publish on the Forge as an ORBIT addon, or import someone else's. Imports land as UNSAVED changes: review them on the map, then hit the global Save.">
        <div class="d-flex flex-wrap" style="gap:32px">
            <div style="min-width:320px; flex:1">
                <MudText Typo="Typo.subtitle2" Class="mb-1">Export</MudText>
                <MudTextField T="string" @bind-Value="_packName" Label="Pack name" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                <MudTextField T="string" @bind-Value="_packAuthor" Label="Author" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                <MudTextField T="string" @bind-Value="_packDescription" Label="Description" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Class="mb-2" />
                <MudRadioGroup T="bool" @bind-Value="_exportAllMaps">
                    <MudRadio T="bool" Value="false" Dense="true">Current map only (@ZoneStoreService.MapLabels[_mapId])</MudRadio>
                    <MudRadio T="bool" Value="true" Dense="true">All maps</MudRadio>
                </MudRadioGroup>
