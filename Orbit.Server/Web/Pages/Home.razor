@page "/orbit"
@layout Orbit.Server.Web.Shared.MainLayout
@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@using Orbit.Server.Config
@inject ConfigService Configs
@inject ISnackbar Snackbar

<PageTitle>ORBIT</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    <div class="text-center mt-8 mb-8">
        <svg width="72" height="72" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2" fill="#FFB454" />
            <ellipse cx="12" cy="12" rx="10" ry="4.2" fill="none" stroke="#4FD1C5" stroke-width="1.3" transform="rotate(-24 12 12)" />
            <circle cx="3.2" cy="16" r="1.6" fill="#4FD1C5" />
        </svg>
        <MudText Typo="Typo.h3" Style="letter-spacing:.35em; font-weight:600; margin-left:.35em">ORBIT</MudText>
        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined" Class="mt-2">@("v" + Version)</MudChip>
        <MudText Typo="Typo.h6" Class="mt-3">More to do. More ways to play.</MudText>
        <MudText Typo="Typo.body1" Class="mt-2" Style="opacity:.7">
            Squads pursue objectives, loot, regroup and extract. SAIN handles their combat.
        </MudText>
        <div class="d-flex flex-wrap justify-center mt-5" style="gap:12px">
            <MudButton Href="/orbit/presets" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.FolderOpen">Choose a preset</MudButton>
            <MudButton Href="/orbit/zone-editor" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.EditLocationAlt">Edit your zones</MudButton>
            <MudButton Href="https://github.com/Chazut/ORBIT/wiki" Target="_blank" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.MenuBook">Wiki &amp; help</MudButton>
        </div>
    </div>

    <MudText Typo="Typo.h5" Class="mb-3">Explore 3.0</MudText>
    <MudGrid Spacing="3" Class="mb-5">
        @foreach (var feature in Features)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Outlined="true" Class="pa-5" Style="height:100%; display:flex; flex-direction:column; gap:12px">
                    <div class="d-flex align-center" style="gap:12px">
                        <MudIcon Icon="@feature.Icon" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">@feature.Title</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Style="opacity:.75; flex:1">@feature.Description</MudText>
                    <MudLink Href="@feature.Href" Underline="Underline.Hover">@feature.Action &rarr;</MudLink>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <SettingsCard Title="Make it your raid" Subtitle="Start with Default for varied raids, or try a community preset.">
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle1">Review, tweak, apply</MudText>
                <MudText Typo="Typo.body2" Class="mt-1">
                    Choose config, zones or both. Compare the result with ORBIT Default and adjust it before applying.
                    Your tweaks create a personal copy; the original preset stays intact.
                </MudText>
                <MudLink Href="/orbit/presets" Class="mt-2">Manage presets &amp; export a ZIP</MudLink>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle1">Your maps, your objectives</MudText>
                <MudText Typo="Typo.body2" Class="mt-1">
                    Add attraction or avoidance zones, set floors and bot filters, and create custom rush destinations.
                    Capture Rush door in F12 adds room-rush points from in-game doors.
                </MudText>
                <MudLink Href="/orbit/map-settings" Class="mt-2">Tune individual maps</MudLink>
            </MudItem>
        </MudGrid>
    </SettingsCard>

    <SettingsCard Title="Before your next raid">
        <MudList T="string" Dense="true">
            <MudListItem Icon="@Icons.Material.Filled.Check">Keep SAIN extraction OFF so ORBIT can manage exits.</MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Psychology">
                <MudLink Href="https://github.com/Chazut/SAIN-Personality-Mixer" Target="_blank">SAIN Personality Mixer</MudLink>
                is highly recommended for more varied PMC personalities. It is optional.
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Save">Save your edits to use them next raid. Faction takeover and brain lists need a game restart.</MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Groups">Playing with Fika? Install matching ORBIT and Fika addon versions on the host, all players and the headless client if used.</MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.BugReport">Need help? F12 contains logging, performance logging and Create debug ZIP. Raid Review helps explain what each bot did.</MudListItem>
        </MudList>
        <MudLink Href="https://github.com/Chazut/ORBIT/wiki/Compatibility" Target="_blank">Compatibility notes</MudLink>
    </SettingsCard>

    <MudExpansionPanels Class="mb-6">
        <MudExpansionPanel Text="Config JSON import / export">
            <MudText Typo="Typo.body2" Class="mb-3">
                For a complete backup with zones, use the ZIP export on the Presets page.
                JSON imports below become unsaved settings: review them, then Save.
            </MudText>
            <div class="d-flex flex-wrap align-center" style="gap:12px">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.IosShare" OnClick="GenerateExport">Generate config export</MudButton>
                @if (_exportHref != null)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download"
                               Href="@_exportHref" UserAttributes="@(new Dictionary<string, object?> { ["download"] = _exportFileName })">@_exportFileName</MudButton>
                }
                <MudButton HtmlTag="label" for="orbit-home-import" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.UploadFile">Import a config (.json)</MudButton>
                <InputFile id="orbit-home-import" OnChange="@(e => ImportConfigFile(e.File))" accept=".json" style="display:none" />
            </div>
            @if (_importSummary != null)
            {
                <MudText Typo="Typo.body2" Class="mt-2" Style="opacity:.7">@_importSummary</MudText>
            }
        </MudExpansionPanel>
    </MudExpansionPanels>
</MudContainer>

@code {
    private sealed record Feature(string Title, string Description, string Href, string Action, string Icon);
    private static readonly Feature[] Features =
    [
        new("Rush objectives", "Spawn sectors, boss areas, marked rooms, sniper positions and custom destinations give squads a purpose from the start.", "/orbit/rush", "Set up rushes", Icons.Material.Filled.DirectionsRun),
        new("Ambushes & airdrops", "Squads hold hotspots, camp extracts or approach airdrops, with cover roles and personality-based choices.", "/orbit/ambush", "Tune ambushes", Icons.Material.Filled.Visibility),
        new("Multi-step objectives", "Power, switches and locked doors: squads work through objectives such as KIBA, ULTRA Medical, Saferoom and D-2.", "/orbit/multi-step", "Explore operations", Icons.Material.Filled.Route),
        new("Squads & personalities", "Shared goals, regrouping, travel styles and looting cover. Personality shapes how squads spend their raid.", "/orbit/personalities", "Shape behavior", Icons.Material.Filled.Groups),
        new("Looting & extraction", "Search bodies, containers and loose loot, upgrade equipment, then leave based on loot, objectives, time or injuries.", "/orbit/extraction", "Adjust extraction", Icons.Material.Filled.ExitToApp),
        new("Ghost Mode", "Distant bots use a lighter simulation while moving, looting and fighting. They wake near players and through scoped views.", "/orbit/ghost-mode", "Configure Ghost Mode", Orbit.Server.Web.OrbitIcons.Ghost),
    ];
    private static readonly string Version = new OrbitServerMetadata().Version.ToString();

    private string? _exportHref;
    private string? _exportFileName;
    private string? _importSummary;

    private void GenerateExport()
    {
        var json = Configs.ToJson();
        _exportFileName = "orbit-config.json";
        _exportHref = "data:application/json;base64," + Convert.ToBase64String(Encoding.UTF8.GetBytes(json));
    }

    private async Task ImportConfigFile(IBrowserFile? file)
    {
        if (file == null) return;
        try
        {
            using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 5_000_000));
            var json = await reader.ReadToEndAsync();
            if (!Configs.ImportJson(json))
            {
                _importSummary = "Nothing importable in that file.";
                return;
            }
            var changes = Configs.GetPendingChanges().Count;
            _importSummary = changes == 0
                ? "Imported : identical to your current saved config, nothing to change."
                : $"Imported : {changes} setting(s) differ from your saved config.";
            if (changes > 0)
                Snackbar.Add($"Config imported ({changes} changes) as unsaved changes : review, then Save.", Severity.Success);
        }
        catch (Exception ex)
        {
            _importSummary = $"Import failed: {ex.Message}";
            Snackbar.Add("Config import failed : is this an ORBIT config .json?", Severity.Error);
        }
    }
}
