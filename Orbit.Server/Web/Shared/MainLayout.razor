@inherits LayoutComponentBase
@implements IDisposable
@inject ConfigService Configs
@inject Orbit.Server.Zones.ZoneStoreService ZoneStore
@inject EditHistoryService History
@inject Orbit.Server.Presets.PresetService Presets
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudThemeProvider IsDarkMode="true" Theme="_orbitTheme" />
<MudPopoverProvider />
<MudSnackbarProvider />
<MudDialogProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="false" Style="border-bottom: 1px solid var(--mud-palette-lines-default); backdrop-filter: blur(6px);">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <svg width="22" height="22" viewBox="0 0 24 24" style="margin-right:10px; flex-shrink:0">
            <circle cx="12" cy="12" r="4.2" fill="#FFB454" />
            <ellipse cx="12" cy="12" rx="10" ry="4.2" fill="none" stroke="#4FD1C5" stroke-width="1.3" transform="rotate(-24 12 12)" />
            <circle cx="3.2" cy="16" r="1.6" fill="#4FD1C5" />
        </svg>
        <MudText Typo="Typo.h6" Style="letter-spacing: .35em; font-weight: 600;">ORBIT</MudText>
        <PresetPicker />
        <MudSpacer />
        <MudTooltip Text="@($"Undo the last change (Ctrl+Z){(History.UndoCount > 0 ? $", {History.UndoCount} step(s) available" : "")}. Covers every config page and the zone editor.")" Placement="Placement.Bottom">
            <MudIconButton Icon="@Icons.Material.Filled.Undo" Color="Color.Inherit" Size="Size.Small" Disabled="@(!History.CanUndo)" OnClick="Undo" />
        </MudTooltip>
        <MudTooltip Text="@($"Redo (Ctrl+Y or Ctrl+Shift+Z){(History.RedoCount > 0 ? $", {History.RedoCount} step(s) available" : "")}")" Placement="Placement.Bottom">
            <MudIconButton Icon="@Icons.Material.Filled.Redo" Color="Color.Inherit" Size="Size.Small" Class="mr-3" Disabled="@(!History.CanRedo)" OnClick="Redo" />
        </MudTooltip>
        @if (_pendingChanges.Count > 0)
        {
            <div class="mr-3" style="position: relative">
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.EditNote"
                           OnClick="@(() => _changesOpen = !_changesOpen)">
                    Unsaved changes (@_pendingChanges.Count)
                </MudButton>
                <MudPopover Open="_changesOpen" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="pa-0">
                    <div class="px-4 py-2" style="max-height: 340px; overflow-y: auto; min-width: 360px">
                        @foreach (var change in _pendingChanges)
                        {
                            <div class="d-flex align-center" style="gap: 8px; font-size: .8rem; padding: 3px 0; white-space: nowrap">
                                <span style="opacity:.65">@FormatPath(change.Path)</span>
                                <MudSpacer />
                                <span style="opacity:.5; text-decoration: line-through">@change.From</span>
                                <span style="opacity:.5">&rarr;</span>
                                <span class="mud-primary-text">@change.To</span>
                            </div>
                        }
                    </div>
                    <MudDivider />
                    <div class="d-flex px-2 py-1" style="min-width: 360px">
                        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Undo" OnClick="DiscardAll">Discard all</MudButton>
                        <MudSpacer />
                        <MudButton Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="Save">Save</MudButton>
                    </div>
                </MudPopover>
            </div>
            <MudOverlay Visible="_changesOpen" OnClick="@(() => _changesOpen = false)" ZIndex="1299" LockScroll="false" />
        }
        <MudTooltip Text="Save settings and zones in the selected preset. Applies next raid; faction takeover and personality brain lists need a game restart." Placement="Placement.Bottom">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="Save" Size="Size.Small" Disabled="@(Presets.Error != null)">Save</MudButton>
        </MudTooltip>
        <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None" Class="ml-4" Style="opacity:.6; font-size:.85rem">Server home</MudLink>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Breakpoint="Breakpoint.Md"
               Style="border-right: 1px solid var(--mud-palette-lines-default);">
        <MudNavMenu Bordered="true" Color="Color.Primary" Class="pt-2">
            <MudNavLink Href="/orbit" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Overview</MudNavLink>
            <MudNavLink Href="/orbit/presets" Icon="@Icons.Material.Filled.FolderOpen">Presets</MudNavLink>
            <MudNavLink Href="/orbit/factions" Icon="@Icons.Material.Filled.Groups">Factions</MudNavLink>
            <MudNavLink Href="/orbit/general" Icon="@Icons.Material.Filled.Tune">General</MudNavLink>
            <MudNavLink Href="/orbit/looting" Icon="@Icons.Material.Filled.Backpack">Looting</MudNavLink>
            <MudNavLink Href="/orbit/extraction" Icon="@Icons.Material.Filled.ExitToApp">Extraction</MudNavLink>
            <MudNavLink Href="/orbit/player-scav" Icon="@Icons.Material.Filled.DirectionsRun">Player Scav</MudNavLink>
            <MudNavLink Href="/orbit/main-objectives" Icon="@Icons.Material.Filled.Flag">Main objectives</MudNavLink>
            <MudNavLink Href="/orbit/poi-guard" Icon="@Icons.Material.Filled.Timer">POI guard</MudNavLink>
            <MudNavLink Href="/orbit/zones-config" Icon="@Icons.Material.Filled.TrackChanges">Zones</MudNavLink>
            <MudNavLink Href="/orbit/zone-editor" Icon="@Icons.Material.Filled.EditLocationAlt">Zone editor</MudNavLink>
            <MudNavLink Href="/orbit/personalities" Icon="@Icons.Material.Filled.Psychology">Personalities</MudNavLink>
            <MudNavLink Href="/orbit/ghost-mode" Icon="@Orbit.Server.Web.OrbitIcons.Ghost">Ghost Mode</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="pa-6 pt-16">
        @if (Presets.Error != null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@Presets.Error</MudAlert>
        }
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    // ORBIT house theme: deep space navy, amber "sun" primary, teal orbit-ring secondary.
    // Deliberately distinct from the stock MudBlazor look of the SAIN / ABPS / APBS pages.
    private readonly MudTheme _orbitTheme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#FFB454",
            // Filled amber/teal surfaces get night-navy text: white on those light accents is unreadable.
            PrimaryContrastText = "#0B0F1A",
            Secondary = "#4FD1C5",
            SecondaryContrastText = "#0B0F1A",
            Tertiary = "#8B9BFF",
            TertiaryContrastText = "#0B0F1A",
            WarningContrastText = "#0B0F1A",
            InfoContrastText = "#0B0F1A",
            SuccessContrastText = "#0B0F1A",
            Background = "#0B0F1A",
            Surface = "#121826",
            AppbarBackground = "#0B0F1ACC",
            AppbarText = "#E6EAF2",
            DrawerBackground = "#0E1420",
            DrawerText = "#B9C2D4",
            DrawerIcon = "#8A94A8",
            TextPrimary = "#E6EAF2",
            TextSecondary = "#9AA4B8",
            ActionDefault = "#9AA4B8",
            LinesDefault = "#222B3E",
            LinesInputs = "#33405A",
            TableLines = "#222B3E",
            Divider = "#222B3E",
            Info = "#4FD1C5",
            Success = "#7BD88F",
            Warning = "#FFB454",
            Error = "#FF6B6B",
            HoverOpacity = 0.08,
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "10px",
            AppbarHeight = "64px",
        },
    };

    // The pages mutate the config object directly through their bindings, so the layout cannot be
    // notified of edits — a poll diffing against the last-saved snapshot keeps the "unsaved changes"
    // button honest at negligible cost (a small serialize per tick). The same tick feeds the undo
    // history, which is why it runs twice a second: an edit becomes undoable within a second.
    private List<(string Path, string From, string To)> _pendingChanges = new();
    private bool _changesOpen;
    private System.Threading.Timer? _pollTimer;

    protected override void OnInitialized()
    {
        Presets.Initialize();
        Presets.Changed += OnPresetChanged;
        _pollTimer = new System.Threading.Timer(_ => InvokeAsync(PollChanges), null, 500, 500);
    }

    public void Dispose()
    {
        _pollTimer?.Dispose();
        Presets.Changed -= OnPresetChanged;
        _selfRef?.Dispose();
    }

    // ── undo / redo ──

    private DotNetObjectReference<MainLayout>? _selfRef;

    // Ctrl+Z / Ctrl+Y / Ctrl+Shift+Z anywhere on an ORBIT page. Text fields keep the browser's own undo;
    // sliders and switches are inputs too but have none, so they do not block the shortcut (a slider keeps
    // the focus after a drag, which is exactly when Ctrl+Z gets pressed).
    private const string ShortcutScript = @"
        window.orbitRegisterKeys = function (ref) {
            window.__orbitKeysRef = ref;
            if (window.__orbitKeysBound) return;
            window.__orbitKeysBound = true;
            document.addEventListener('keydown', function (e) {
                if (!(e.ctrlKey || e.metaKey) || e.altKey) return;
                var k = (e.key || '').toLowerCase();
                if (k !== 'z' && k !== 'y') return;
                if (location.pathname.indexOf('/orbit') !== 0) return;
                var t = e.target, tag = t && t.tagName ? t.tagName.toLowerCase() : '';
                if (tag === 'textarea' || (t && t.isContentEditable)) return;
                if (tag === 'input' && !/^(range|checkbox|radio|button|submit)$/i.test(t.type || '')) return;
                var ref = window.__orbitKeysRef;
                if (!ref) return;
                e.preventDefault();
                ref.invokeMethodAsync(k === 'y' || e.shiftKey ? 'RedoFromKey' : 'UndoFromKey').catch(function () { });
            });
        };";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("eval", ShortcutScript);
            await JS.InvokeVoidAsync("orbitRegisterKeys", _selfRef);
        }
        catch
        {
            // No shortcuts (script blocked or circuit gone): the AppBar buttons still work.
        }
    }

    [JSInvokable] public Task UndoFromKey() => InvokeAsync(Undo);
    [JSInvokable] public Task RedoFromKey() => InvokeAsync(Redo);

    private void Undo()
    {
        if (!History.Undo()) return;
        PollChanges();
        StateHasChanged();
    }

    private void Redo()
    {
        if (!History.Redo()) return;
        PollChanges();
        StateHasChanged();
    }

    private void PollChanges()
    {
        try
        {
            Presets.TrackEdits();
            Presets.RefreshAddons();
            _presetPollError = null;
        }
        catch (Exception ex)
        {
            if (_presetPollError != ex.Message) Snackbar.Add(ex.Message, Severity.Error);
            _presetPollError = ex.Message;
        }
        var historyMoved = History.Track();
        var changes = Configs.GetPendingChanges();
        // Zone-editor edits ride the same unsaved-changes button as config edits.
        foreach (var mapId in ZoneStore.GetPendingMaps())
            changes.Add(($"Zone editor.{Orbit.Server.Zones.ZoneStoreService.MapLabels[mapId]}", "saved", "edited"));
        if (changes.Count == _pendingChanges.Count && changes.SequenceEqual(_pendingChanges))
        {
            if (historyMoved) StateHasChanged(); // the undo / redo buttons changed state
            return;
        }
        _pendingChanges = changes;
        if (_pendingChanges.Count == 0) _changesOpen = false;
        StateHasChanged();
    }

    private static string FormatPath(string path) => path.Replace(".", " / ").Replace("_", " ");
    private string? _presetPollError;
    private void OnPresetChanged() => InvokeAsync(PollChanges);

    private void Save()
    {
        try
        {
            Presets.Save();
            PollChanges();
            Snackbar.Add($"{Presets.ActiveName} saved. Applies next raid; faction takeover and brain lists need a game restart.", Severity.Success);
            if (Presets.MirrorWarning != null) Snackbar.Add(Presets.MirrorWarning, Severity.Warning);
        }
        catch (Exception ex) { Snackbar.Add($"Save failed: {ex.Message}", Severity.Error); }
    }

    private void DiscardAll()
    {
        Configs.DiscardChanges();
        ZoneStore.DiscardAllPending();
        PollChanges();
        Snackbar.Add("Unsaved changes discarded.", Severity.Info);
    }
}
